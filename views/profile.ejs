<!DOCTYPE html>
<html lang="en">

<%- include("./partials/header.ejs") %>

<body>
  <%- include("./partials/nav.ejs") %>

    <!--Main Content-->
    <div id="profile-container">

    <!-- USER CARD -->
    <div class="profile-card">

        <div class="profile-avatar">
        <img src="/img/profile_svg.svg" alt="User Avatar">
        </div>

        <div class="profile-info">
          <form id="profileForm">

            <div class="profile-field">
              <label>Username</label>
              <input type="text" name="username" class="profile-input" value="<%= user.username %>" disabled>
            </div>

            <div class="profile-field">
              <label>Email</label>
              <input type="email" name="email" class="profile-input" value="<%= user.email %>" disabled>
            </div>

            <button type="button" id="editProfileBtn" class="btn">Update Profile</button>

          </form>
        </div>


    </div>

    </div>

    <script>
    const editBtn = document.getElementById('editProfileBtn');
    const inputs = document.querySelectorAll('#profileForm input');

    editBtn.addEventListener('click', () => {
    inputs.forEach(input => input.disabled = !input.disabled);
    editBtn.textContent = inputs[0].disabled ? 'Update Profile' : 'Save Changes';
    });
    </script>


  <%- include("./partials/footer.ejs") %>
  
    <!-- Floating Dark Mode Toggle -->
    <button class="theme-toggle" id="themeToggle" aria-label="Toggle Dark Mode">
      <img id="themeIcon" src="/img/darkMode_svg.svg" width="22" height="22" alt="Theme icon...">
    </button>

    <!--Calling JavaScript for Theme function-->
    <script src="/js/theme.js"></script>
    <!--Calling JavaScript for Profile Form function-->
    <script src="/js/profile.js"></script>
    
</body>

</html>