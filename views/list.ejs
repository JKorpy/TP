<!DOCTYPE html>
<html lang="en">
    <%- include("./partials/header.ejs") %>   
<body>
    <%- include("./partials/nav.ejs") %>

    <main>
        <h1>Shopping List</h1>
        <p>Discover the best value prices of products from supermarkets across Ireland.</p>
    </main>
 
    <div id="list-container">
        <!-- Table -->
        <table id="list-table">
            <colgroup>
                <col style="width: 50%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 10%;">
                <col style="width: 10%;">
            </colgroup>
            <!-- Header -->
            <tr>
                <th>Name</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
            <!-- Rows (Name, Quantity, Price, Edit, Delete) -->
            <% if (items.length > 0) { %>
                <% items.forEach(item => { %>
                    <tr>
                        <td class="product-name">(<%= item.name %>) <%= item.description %></td>
                        <td class="product-qty"><%= item.quantity %></td>
                        <td class="product-price">€<%=(item.price * item.quantity).toFixed(2) %></td>
                        <td>
                            <div class="edit-buttons">
                                <button type="button" class="quantity-btn quantity-decrease">−</button>
                                <button type="button" class="quantity-btn quantity-increase">+</button>
                            </div>
                        </td>
                        <td>
                            <button type="button" class="product-delete-btn" data-id="<%= item.id %>">Delete</button>
                        </td>
                    </tr>
                <% }) %> 
            <% } else { %>
                <p>No items available...</p>
            <% } %>                
            <!-- Final Row (Total) --> 
            <tr id="list-footer">
                <td colspan="5">Total: £0.00</td>
            </tr>
        </table>
    </div>
    <%- include("./partials/footer.ejs") %> 
</body>
</html>
