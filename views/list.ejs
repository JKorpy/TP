<!DOCTYPE html>
<html lang="en">
    <%- include("./partials/header.ejs") %>   
<body>
    <%- include("./partials/nav.ejs") %>

    <main>
        <h1>Shopping List</h1>
        <p>Discover the best value prices of products from supermarkets across Ireland.</p>
    </main>

    <div id="list-container">
        <!-- Table -->
        <table id="list-table">
            <colgroup>
                <col style="width: 50%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 10%;">
                <col style="width: 10%;">
            </colgroup>
            <!-- Header -->
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <!-- Rows (Name, Quantity, Price, Edit, Delete) -->
            <tbody>
                <% if (items.length > 0) { %>
                    <% items.forEach(item => { %>
                        <tr data-id="<%= item.id %>">
                            <td class="product-name">(<%= item.name %>) <%= item.description %></td>
                            <td class="product-qty"><%= item.quantity %></td>
                            <td class="product-price" data-price="<%=parseFloat(item.total).toFixed(2) %>">€<%=parseFloat(item.total).toFixed(2)%></td>
                            <td>
                                <div class="edit-buttons">
                                    <button type="button" class="quantity-btn quantity-decrease">−</button>
                                    <button type="button" class="quantity-btn quantity-increase">+</button>
                                </div>
                            </td>
                            <td>
                                <button type="button" class="product-delete-btn">Delete</button>
                            </td>
                        </tr>
                    <% }) %> 
                <% } else { %>
                    <tr><td colspan="5">No items available...</td></tr>
                <% } %>                
                <!-- Final Row (Total) --> 
                <tr id="list-footer">
                    <% const fullTotal = items.reduce((sum, item) => sum + parseFloat(item.total), 0); %>
                    <td colspan="5">Total: €<%= fullTotal.toFixed(2) %></td>
                </tr>
            </tbody>
        </table>
    </div>
    <%- include("./partials/footer.ejs") %> 


    
    <!-- Floating Dark Mode Toggle -->
    <button class="theme-toggle" id="themeToggle" aria-label="Toggle Dark Mode">
      <img id="themeIcon" src="/img/darkMode_svg.svg" width="22" height="22" alt="Theme icon...">
    </button>

    <script src="/js/theme.js"></script>
    <script src="/js/list.js"></script>
</body>
</html>
