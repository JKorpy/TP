<!DOCTYPE html>
<html lang="en">
    <%- include("./partials/header.ejs") %>   
<body>
    <%- include("./partials/nav.ejs") %>

    <main>
        <h1>Shopping List</h1>
        <p>Discover the best value prices of products from supermarkets across Ireland.</p>
    </main>

    <div id="list-container">
        <!-- Table -->
        <table id="list-table">
            <colgroup>
                <col style="width: 50%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 10%;">
                <col style="width: 10%;">
            </colgroup>
            <!-- Header -->
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <!-- Rows (Name, Quantity, Price, Edit, Delete) -->
            <tbody>
                <% if (items.length > 0) { %>
                    <% items.forEach(item => { %>
                        <tr data-id="<%= item.id %>">
                            <td class="product-name">(<%= item.name %>) <%= item.description %></td>
                            <td class="product-qty"><%= item.quantity %></td>
                            <td class="product-price">€<%=(item.price * item.quantity).toFixed(2) %></td>
                            <td>
                                <div class="edit-buttons">
                                    <button type="button" class="quantity-btn quantity-decrease">−</button>
                                    <button type="button" class="quantity-btn quantity-increase">+</button>
                                </div>
                            </td>
                            <td>
                                <button type="button" class="product-delete-btn">Delete</button>
                            </td>
                        </tr>
                    <% }) %> 
                <% } else { %>
                    <tr><td colspan="5">No items available...</td></tr>
                <% } %>                
                <!-- Final Row (Total) --> 
                <tr id="list-footer">
                    <td colspan="5">Total: £0.00</td>
                </tr>
            </tbody>
        </table>
    </div>
    <%- include("./partials/footer.ejs") %> 
    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const table = document.getElementById("list-table");
            if (!table) return;

            // --- Event Delegation on tbody ---
            const tbody = table.querySelector("tbody");
            tbody.addEventListener("click", async (e) => {

                const row = e.target.closest("tr");
                if (!row || !row.dataset.id) return; // skip total or "no items" rows

                const id = row.dataset.id;
                const qtyEl = row.querySelector(".product-qty");
                const priceEl = row.querySelector(".product-price");

                // --- Increase Quantity ---
                if (e.target.classList.contains("quantity-increase")) {
                    try {
                        const res = await fetch(`/api/items/${id}/increase`, { method: "PUT" });
                        const item = await res.json();
                        qtyEl.textContent = item.quantity;
                        priceEl.textContent = `€${(item.price * item.quantity).toFixed(2)}`;
                        updateTotal();
                    } catch (err) {
                        console.error("Failed to increase quantity:", err);
                    }
                }

                // --- Decrease Quantity ---
                if (e.target.classList.contains("quantity-decrease")) {
                    try {
                        const res = await fetch(`/api/items/${id}/decrease`, { method: "PUT" });
                        const item = await res.json();
                        qtyEl.textContent = item.quantity;
                        priceEl.textContent = `€${(item.price * item.quantity).toFixed(2)}`;
                        updateTotal();
                    } catch (err) {
                        console.error("Failed to decrease quantity:", err);
                    }
                }

                // --- Delete Item ---
                if (e.target.classList.contains("product-delete-btn")) {
                    try {
                        await fetch(`/api/items/${id}`, { method: "DELETE" });
                        row.style.opacity = "0";
                        setTimeout(() => row.remove(), 300);
                        updateTotal();
                    } catch (err) {
                        console.error("Failed to delete item:", err);
                    }
                }

            });

            // --- Live Total Function ---
            function updateTotal() {
                let total = 0;
                tbody.querySelectorAll("tr[data-id]").forEach(row => {
                    const priceText = row.querySelector(".product-price").textContent;
                    total += parseFloat(priceText.replace("€", ""));
                });
                const footer = document.getElementById("list-footer");
                if (footer) footer.querySelector("td").textContent = `Total: €${total.toFixed(2)}`;
            }

            // --- Initialize Total on Page Load ---
            updateTotal();
        });
    </script>
</body>
</html>
