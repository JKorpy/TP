<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="register-page">

    <div class="container d-flex justify-content-center register-container">
        <div class="card shadow-lg register-card">
            <div class="card-body p-4">

                <div class="text-center mb-3">
                    <div class="login-icon">📝</div>
                    <h3 class="fw-bold register-title">Register</h3>
                </div>

                <% if (error) { %>
                    <div class="alert alert-danger py-2">
                        <%= error %>
                    </div>
                <% } %>

                <form action="/register" method="post" novalidate>

                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="form-label">First Name</label>
                            <input type="text" name="firstName" class="form-control">
                        </div>

                        <div class="col-md-6 mb-2">
                            <label class="form-label">Last Name</label>
                            <input type="text" name="lastName" class="form-control" required>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Username</label>
                        <input type="text" name="username" class="form-control" placeholder="Enter username" required>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" placeholder="Enter email" required>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Phone Number</label>
                        <input type="tel" name="phone" class="form-control" placeholder="Enter phone number">
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Date of Birth</label>
                        <input type="date" name="dob" class="form-control">
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control" placeholder="Enter password" required>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm password" required>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Enter Captcha</label>

                        <div class="px-3 py-2 border rounded bg-light fw-bold text-center mb-2 captcha-box">
                            <%= captcha %>
                        </div>

                        <input
                            type="text"
                            name="captchaInput"
                            class="form-control"
                            placeholder="Enter captcha"
                            required
                        >
                    </div>

                    <button class="btn btn-primary w-100 mb-2">Register</button>

                </form>

                <div class="text-center">
                    <p class="mb-0">
                        Already have an account?
                        <a href="/login" class="fw-semibold register-link">Login here</a>
                    </p>
                </div>

            </div>
        </div>
    </div>

    <!-- Floating Dark Mode Toggle -->
    <button class="theme-toggle" id="themeToggle" aria-label="Toggle Dark Mode">
        <img id="themeIcon" src="/img/darkMode_svg.svg" width="22" height="22" alt="Theme icon...">
    </button>

    <script src="/js/theme.js"></script>

</body>
</html>