<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Register</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body{
    background: linear-gradient(135deg,#e3f2fd,#f8f9fa);
}
body{
    background-image: url("https://images.unsplash.com/photo-1557683316-973673baf926");
    background-size: cover;
    background-position: center;
}
.card{
    backdrop-filter: blur(10px);
    background: rgba(255,255,255,0.9);
}
.card{
    border:none;
    border-radius:15px;
}

.form-control{
    border-radius:10px;
}

.btn-primary{
    border-radius:10px;
    padding:10px;
    font-weight:500;
}

.login-icon{
    font-size:40px;
}
</style>

</head>

<body>

<div class="container d-flex justify-content-center align-items-center" style="min-height:100vh;">

<div class="card shadow-lg" style="max-width:420px;width:100%;">
<div class="card-body p-3">

<div class="text-center mb-4">
    <img src="/img/Grocery_1.png" class="logo mb-3" style="width:120px;">
</div>

<div class="text-center mb-3">

<div class="login-icon">📝</div>

<h3 class="fw-bold">Register</h3>

</div>

<% if (error) { %>
<div class="alert alert-danger py-2">
<%= error %>
</div>
<% } %>

<form action="/register" method="post">

<div class="mb-2">
<label class="form-label">Username</label>
<input type="text" name="username" class="form-control" placeholder="Enter username" required>
</div>

<div class="mb-2">
<label class="form-label">Password</label>
<input type="password" name="password" class="form-control" placeholder="Enter password" required>
</div>
<div class="mb-2">
<label class="form-label">Enter Captcha</label>

<div class="px-3 py-2 border rounded bg-light fw-bold text-center mb-2" style="letter-spacing:4px;">
    <%= captcha %>
</div>

<input
    type="text"
    name="captchaInput"
    class="form-control"
    placeholder="Enter captcha"
    required
>
</div>
<button class="btn btn-primary w-100 mb-2">Register</button>

</form>

<div class="text-center">
<p class="mb-0">
Already have an account?
<a href="/login" class="fw-semibold">Login here</a>
</p>
</div>

</div>
</div>

</div>

</body>
</html>