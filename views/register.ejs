<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Register</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body{
    background: linear-gradient(135deg, #dcc0b1, #c9ad9c);
    min-height: 100vh;    
}

/* Card styling */
.card{
    backdrop-filter: blur(12px);
    background: rgba(255,255,255,0.9);
    border:none;
    border-radius:18px;
}

/* Inputs */
.form-control{
    border-radius:10px;
    border: 1px solid #d6b8a6;
}

.form-control:focus{
    border-color: #c8a691;
    box-shadow: 0 0 5px rgba(200,166,145,0.6);
}

/* Button */
.btn-primary{
    background: linear-gradient(135deg,#d6b8a6,#c8a691);
    border:none;
    border-radius:10px;
    padding:10px;
    font-weight:500;
}

.btn-primary:hover{
    transform: translateY(-2px);
    box-shadow: 0 8px 15px rgba(0,0,0,0.2);
}

/* Icon */
.login-icon{
    font-size:40px;
}
</style>

</head>

<body>

<div class="container d-flex justify-content-center" style="min-height:100vh;">

<div class="card shadow-lg" style="max-width:650px;width:100%;">
<div class="card-body p-4">

<div class="text-center mb-3">

<div class="login-icon">📝</div>

<h3 class="fw-bold" style="color:#6b4f3f;">Register</h3>

</div>

<% if (error) { %>
<div class="alert alert-danger py-2">
<%= error %>
</div>
<% } %>

<form action="/register" method="post">

<div class="row">
    <div class="col-md-6 mb-2">
        <label class="form-label">First Name</label>
        <input type="text" name="firstName" class="form-control" required>
    </div>

    <div class="col-md-6 mb-2">
        <label class="form-label">Last Name</label>
        <input type="text" name="lastName" class="form-control" required>
    </div>
</div>

<div class="mb-2">
<label class="form-label">Username</label>
<input type="text" name="username" class="form-control" placeholder="Enter username" required>
</div>

<div class="mb-2">
<label class="form-label">Email</label>
<input type="email" name="email" class="form-control" placeholder="Enter email" required>
</div>

<div class="mb-2">
<label class="form-label">Phone Number</label>
<input type="tel" name="phone" class="form-control" placeholder="Enter phone number">
</div>

<div class="mb-2">
<label class="form-label">Date of Birth</label>
<input type="date" name="dob" class="form-control">
</div>

<div class="mb-2">
<label class="form-label">Password</label>
<input type="password" name="password" class="form-control" placeholder="Enter password" required>
</div>

<div class="mb-2">
<label class="form-label">Confirm Password</label>
<input type="password" name="confirmPassword" class="form-control" placeholder="Confirm password" required>
</div>

<div class="mb-2">
<label class="form-label">Enter Captcha</label>

<div class="px-3 py-2 border rounded bg-light fw-bold text-center mb-2" style="letter-spacing:4px;">
    <%= captcha %>
</div>

<input
    type="text"
    name="captchaInput"
    class="form-control"
    placeholder="Enter captcha"
    required
>
</div>

<button class="btn btn-primary w-100 mb-2">Register</button>

</form>

<div class="text-center">
<p class="mb-0">
Already have an account?
<a href="/login" class="fw-semibold" style="color:#b08968;">Login here</a>
</p>
</div>

</div>
</div>

</div>


</body>
</html>