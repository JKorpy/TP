

<!DOCTYPE html>
<html lang="en">
    <%- include("./partials/header.ejs") %>   
<body>
    <%- include("./partials/nav.ejs") %>
    <!-- Catalogue Header -->
    <main>
        <h1>Welcome to Catalogue</h1>
        <p>Browse Products!</p>
    </main>
    <!-- Catalogue Section -->
    <div id="catalogue-container">
        <!-- Sidebar -->
        <div id="catalogue-sidebar">
            <div id="sticky-sidebar">
                <h2>Filters</h2>
                <form id="catalogue-filter">
                    <!-- Search -->
                    <div class="filter-group">
                        <label for="search">Search</label>
                        <input type="text" id="search" placeholder="Search products...">
                    </div>
                    <!-- Select Dropdown -->
                    <div class="filter-group">
                        <label for="select">Select</label>
                        <select class="category">
                        <option value="ascending">Ascending Order</option>
                        <option value="descending">Descending Order</option>
                        <option value="lowPrice">Price - Lowest First</option>
                        <option value="highPrice">Price - Highest FIrce</option>
                        </select>
                    </div>
                    <!-- Select Dropdown -->
                    <div class="filter-group">
                        <label for="category">Category</label>
                        <select class="category">
                        <option value="food">Food</option>
                        <option value="clothe">Clothes</option>
                        <option value="electronic">Electronics</option>
                        </select>
                    </div>                
                    <!-- Checkbox Filters -->
                    <div class="filter-group">
                        <label>Brand</label>
                        <!-- Brand -->
                        <div class="checkbox-group">
                        <label class="checkbox-item">
                            <input type="checkbox" name="check" value="lidl-val">
                            <span>Lidl</span>
                        </label>
                        <!-- Clothes -->
                        <label class="checkbox-item">
                            <input type="checkbox" name="check" value="aldi-val">
                            <span>Aldi</span>
                        </label>
                        <!-- Item -->
                        <label class="checkbox-item">
                            <input type="checkbox" name="check" value="supervalu-val">
                            <span>Supervalu</span>
                        </label>
                        </div>
                    </div>
                    <!-- Submit Button -->
                    <button type="submit" id="filterBTN">Apply Filters</button>
                </form>
            </div>
        </div>
        <!-- Contents -->
        <div id="catalogue-cards">
            <% if (products.length > 0) { %>
                <% products.forEach(product => { %>
                    <!-- Product Card -->
                    <div class="catalogue-card">
                        <!-- Image -->
                        <div class="card-image">
                            <img class="product-image"src="https://picsum.photos/400/300" alt="<%= product.name %>"">
                        </div>
                        <!-- Description -->
                        <div class="card-content">
                            <!-- Title -->
                            <h3 class="card-title">(<%= product.name %>) <%= product.description %></h3>
                            <!-- Price & Button -->
                            <div class="card-footer">
                                <p class="card-price">€<%= product.price %></p>
                                <button class="cardBTN" data-id="<%= product.id %>">Add to List</button>
                            </div>
                        </div>
                    </div>
                <% }) %> 
            <% } else { %>
            <p>No products available...</p>
            <% } %>            
        </div>
        <!-- Pagination -->
        <footer id="catalogue-footer">
            <p>Showing 1 - 12 of 96</p>
            <!-- Page Numbers -->
            <div id="page-numbers">
                <!-- Previous Page -->
                <button class="page-btn">« Prev</button>
                <button class="page-number active">1</button>
                <button class="page-number">2</button>
                <button class="page-number">3</button>
                <button class="page-number">4</button>
                <button class="page-number">5</button>
                <!-- Next Page -->
                <button class="page-btn">Next »</button>            
            </div>
        </footer>
    </div>    
    <!-- Catalogue Modal -->
    <div id="catalogue-modal" class="modal">
        <!-- Modal Body -->
        <div class="modal-body" data-id="">
            <!-- Modal Header -->
            <div class="modal-header">
                <h2>Product</h2>
            </div>
            <!-- Modal Section (Product)-->
            <div id="product-section" class="modal-section">
                <!-- Image -->
                <div><img id="product-image"src="https://picsum.photos/400/300" alt="Product image"></div>
                <!-- Description -->
                <div id="product-content">
                    <!-- Title -->
                    <h3 id="product-title">Item this is a very nice product 500ml and 600gb. What would you like?</h3>
                    <!-- Description -->
                    <p id="product-description">What to do?</p>
                    <!-- Price & Button -->
                    <div id="product-footer">
                        <p id="product-price">€5.50</p>
                        <button class="modal-btn">Add to List</button>
                        <button id="compare-btn">Compare</button>
                    </div>
                </div>   
            </div>  
            <!-- Modal Footer --> 
            <div class="modal-footer">
                <button id="modal-close-btn">Close</button>
            </div>             
        </div>
    </div>
    <%- include("./partials/footer.ejs") %> 
    <script>
        const modal = document.getElementById("catalogue-modal");
        const closeModalBTN = document.getElementById("modal-close-btn");

        document.querySelectorAll(".product-image").forEach(action => {
            action.addEventListener("click", function() {
                modal.style.display = "block";
            });
        });       
        
        closeModalBTN.addEventListener("click", () => {
            modal.style.display = "none";
        });

        document.querySelectorAll(".cardBTN").forEach(button => {
            button.addEventListener("click", async () => {
                const productId = button.dataset.id;

                await fetch("/catalogue/add", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ id: productId })
                });

                alert("Product added!");
            });
        });
    </script>
</body>
</html>