  <div class="footer-content">

    <!-- Left Column-->
    <div class="footer-section">
      <h4>About Us</h4>
      <p>bVIPs is here to help you find the best value products across Ireland!</p>
    </div>

    <!-- Middle Column-->
    <div class="footer-section">
      <h4>Socials</h4>
      <ul>
        <li>
          <a href="https://www.instagram.com/" data-bs-placement="bottom" title="Instagram">
            <img src="/img/insta_svg.svg" alt="instagram" data-bs-toggle="tooltip" >
          </a>
        </li>
        <li>
          <a href="https://www.facebook.com/" data-bs-placement="bottom" title="Facebook">
            <img src="/img/fb_svg.svg" alt="instagram" data-bs-toggle="tooltip" >
          </a>
        </li>
        <li>
          <a href="https://www.whatsapp.com/" data-bs-placement="bottom" title="WhatsApp">
            <img src="/img/wa_svg.svg" alt="instagram" data-bs-toggle="tooltip" >
          </a>
