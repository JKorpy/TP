<div class="products-comparison">
    <!-- Production Section 1 (Original)-->
    <div id="modal-product-1" class="modal-section">
        <!-- Description -->
        <div id="compare-content-1">
            <img class="compare-image-1" src="https://picsum.photos/400/300" alt="<%= product.name %>">
            <h3 id="compare-name-1"><%= product.name %></h3>
            <p id="compare-brand-1"><%= product.brand %></p>
            <p id="compare-price-1">€<%= product.price %></p>
            <!-- Buttons -->
            <div class="product-footer">
                <button class="add-btn" data-id="<%= product.id %>">Add to List</button>
            </div>
        </div>   
    </div>   
    <!-- Production Section 2 (Comparison)-->
    <div id="modal-product-2" class="modal-section" >
        <div id="compare-content-2">
            <% if (filtered.length > 0) { %>
                <img class="compare-image-2" src="https://picsum.photos/400/300" alt="<%= filtered[0].name %>">
                <h3 id="compare-name-2"><%= filtered[0].name %></h3>
                <p id="compare-brand-2"><%= filtered[0].brand %></p>
                <p id="compare-price-2">€<%= filtered[0].price %></p>
                <div class="product-footer">
                    <button class="add-btn" id="compare-add-btn" data-id="<%= filtered[0].id %>">Add to List</button>
                </div>
            <% } else { %>
                <p>No comparison product available</p>
            <% } %>
        </div>
    </div>                 
</div>
<!-- Table Comparison -->
<div class="table-comparison">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Compare</th>
            </tr>
        </thead>
        <tbody>
            <% if (filtered.length > 0) { %>
                <% filtered.forEach(p => { %>
                    <tr>
                        <td>(<%= p.brand %>) <%= p.name %></td>
                        <td>€<%= p.price %></td>
                        <td>
                            <button class="select-btn"
                                data-id="<%= p.id %>"
                                data-name="<%= p.name %>"
                                data-brand="<%= p.brand %>"
                                data-price="<%= p.price %>">
                                Select
                            </button>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                    <tr><td colspan="3">No relevent products found...</td></tr>
            <% } %>
        </tbody>
    </table>
</div>