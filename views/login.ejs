<!DOCTYPE html>
<html lang="en">
    <%- include("./partials/header.ejs") %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body{
    background-image: url("https://images.unsplash.com/photo-1557683316-973673baf926");
    background-size: cover;
    background-position: center;
    background: linear-gradient(135deg, #dcc0b1, #c9ad9c);
    min-height: 100vh;    
}
.card{
    backdrop-filter: blur(10px);
    background: rgba(255,255,255,0.9);
}
.card{
    border:none;
    border-radius:15px;
}

.form-control{
    border-radius:10px;
}

.btn-primary{
    border-radius:10px;
    padding:10px;
    font-weight:500;
}

.login-icon{
    font-size:40px;
}
</style>

</head>

<body>

<div class="container d-flex justify-content-center align-items-center" style="min-height:100vh;">
  <div class="card shadow-lg" style="max-width:420px;width:100%;">
  <div class="card-body p-2">

<div class="text-center mb-2">

<div class="login-icon">🔐</div>

<h3 class="fw-bold">Login</h3>

</div>

<% if (error) { %>
<div class="alert alert-danger py-2">
<%= error %>
</div>
<% } %>

<form action="/login" method="post">

  <div class="mb-2">
    <label class="form-label">Username</label>
    <input type="text" name="username" class="form-control" placeholder="Enter username" required>
  </div>

  <div class="mb-2">
    <label class="form-label">Password</label>
    <input type="password" name="password" class="form-control" placeholder="Enter password" required>
  </div>

  <div class="mb-2">
    <label class="form-label">Enter Captcha</label>
    <div class="px-3 py-2 border rounded bg-light fw-bold text-center mb-2" style="letter-spacing:4px;">
      <%= captcha %>
    </div>
    <input type="text" name="captchaInput" class="form-control" placeholder="Enter captcha">
  </div>

  <button class="btn btn-primary w-100 mb-3">Login</button>

</form>

<div class="text-center">
<p class="mb-0">
Don't have an account?
<a href="/register" class="fw-semibold">Register here</a>
</p>
</div>

</div>
</div>

</div>

</body>
</html>