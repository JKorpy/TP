<!DOCTYPE html>
<html lang="en">

<%- include("./partials/header.ejs") %>

<body>
  <%- include("./partials/nav.ejs") %>

  <main>
    <h1>Welcome to bVIPs!</h1>
    <p>Discover the best value prices of products from supermarkets across Ireland.</p>
    <a href="/shop" class="btn">Shop Now!</a>
  </main>

  <h2>Featured Products</h2>
  <div class="products-grid">
    <% if (products.length > 0) { %>

    <% products.forEach(product => { %>
        <div class="product-card">
        <img src="<%= product.imageURL %>" alt="<%= product.name %>">
        
        <h3><%= product.name %></h3>
        <p><%= product.description %></p>
        <p class="price">€<%= product.price %></p>
        
        </div>
    <% }) %>

    <% } else { %>
    <p>No products available...</p>
    <% } %>
        </div>



  <section class="about">
    <h2>About Us</h2>
    <p>Our 'best Value Indicator Product selector' focuses on quality and affordability.</p>
  </section>

  <%- include("./partials/footer.ejs") %>

    <!-- Floating Dark Mode Toggle -->
    <button class="theme-toggle" id="themeToggle" aria-label="Toggle Dark Mode">
    <img id="themeIcon" src="/img/darkMode_svg.svg" width="22" height="22">
    </button>

  <script src="/js/theme.js"></script>
</body>

</html>